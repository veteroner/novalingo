# Release imzalama bilgileri — bu dosyayı `keystore.properties` olarak kopyalayın.
# `keystore.properties` git'e GİRMEZ (.gitignore).
#
# Keystore oluşturma (bir kez, güvenli bir yerde yedekleyin — kaybolursa
# Play Console'da aynı uygulamayı güncelleyemezsiniz):
#
#   keytool -genkeypair -v -keystore novalingo-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias novalingo
#
storeFile=/absolute/path/to/novalingo-release.jks
storePassword=CHANGE_ME
keyAlias=novalingo
keyPassword=CHANGE_ME
